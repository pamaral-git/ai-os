{
  "Time": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run", "-i", "--rm", "--init", "--stop-timeout", "2",
      "--label", "com.docker.compose.project=mcp-servers",
      "--label", "com.dockerCompose.service=time",
      "mcp/time"
    ]
  },
  "Files": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run", "-i", "--rm", "--init", "--stop-timeout", "2",
      "--label", "com.docker.compose.project=mcp-servers",
      "--label", "com.dockerCompose.service=filesystem",
      "-v", "/Users/local-path/workspace:/local-directory",
      "mcp/filesystem",
      "/local-directory"
    ]
  },
  "Checklist": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run", "-i", "--rm", "--init", "--stop-timeout", "2",
      "--label", "com.docker.compose.project=mcp-servers",
      "--label", "com.dockerCompose.service=checklist",
      "mcp/server:latest",
      "--mode=backend"
    ]
  },
  "Browser": {
    "type": "stdio",
    "command": "node",
    "args": [
      "/Users/local-path/browser-mcp/node_modules/@browsermcp/mcp/dist/index.js"
    ]
  },
  "DuckDuckGo": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run", "-i", "--rm", "--init", "--stop-timeout", "2",
      "--label", "com.docker.compose.project=mcp",
      "--label", "com.dockerCompose.service=duckduckgo",
      "mcp/duckduckgo"
    ]
  },
  "Markdown": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run", "-i", "--rm", "--init", "--stop-timeout", "2",
      "--label", "com.docker.compose.project=mcp",
      "--label", "com.dockerCompose.service=markdown",
      "-v", "/Users/local-path/workspace:/local-directory",
      "mcp/markitdown"
    ]
  },
  "Thinking": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run", "-i", "--rm", "--init", "--stop-timeout", "2",
      "--label", "com.docker.compose.project=mcp",
      "--label", "com.dockerCompose.service=thinking",
      "mcp/sequentialthinking"
    ]
  },
  "Memory": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run", "-i", "--rm", "--init", "--stop-timeout", "2",
      "--label", "com.docker.compose.project=mcp-servers",
      "--label", "com.dockerCompose.service=memory",
      "-v", "/Users/local-path/workspace:/local-directory",
      "mcp/memory"
    ]
  },
  "REA": {
    "type": "stdio",
    "command": "node",
    "args": ["/Users/local-path/node_modules/rea-agents/scripts/rea.mjs", "mcp"]
  },
  "Agent-Browser": {
    "type": "stdio",
    "command": "agent-browser",
    "args": ["mcp", "--tools", "all"]
  },
  "DeepWiki": {
