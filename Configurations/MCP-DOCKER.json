                "-i",
                "--rm",
                "--init",
                "--stop-timeout",
                "2",
                "--label",
                "com.docker.compose.project=mcp-servers",
                "--label",
                "com.docker.compose.service=wikipedia",
                "mcp/wikipedia-mcp"
            ]
        },
        "Web Fetch": {
            "type": "stdio",
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "--init",
                "--stop-timeout",
                "2",
                "--label",
                "com.docker.compose.project=mcp-servers",
                "--label",
                "com.docker.compose.service=fetch",
