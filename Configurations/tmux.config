set -g mouse on
set -g xterm-keys on
set -s escape-time 0
set -g history-limit 50000
set -g renumber-windows on 
set -g focus-events on
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"
set -g status-style bg=default,fg=colour244
set -g status-left-length 40
set -g status-left "#[fg=colour39,bold]#S #[fg=colour240]| "
set -g status-right "#[fg=colour240]%H:%M #[fg=colour244]%d-%b"
set -g window-status-current-style fg=colour39,bold
set -g window-status-format " #I:#W "
set -g window-status-current-format "[#I:#W]"
set -g extended-keys on
set -g extended-keys-format csi-u
set -g set-clipboard on
bind-key -n C-l send-keys C-l \; send-keys -R \; clear-history
bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key & run-shell '
  content=$(tmux capture-pane -pt "#{pane_id}" | tr -d "[:space:]")
    if [ -z "$content" ] || [ "$content" = "$" ] || [ "$content" = "%" ]; then
    tmux kill-window
  else
    tmux confirm-before -p "Save/Keep window #{window_name}? (y/n)" "kill-window"
  fi
'
