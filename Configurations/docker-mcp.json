{
    "mcpServers": {
        "Files": {
        "command": "docker",
        "args": [
            "run",
            "-i",
            "--rm",
            "-v",
            "/Users/local-path/workspace:/local-directory",
            "mcp/filesystem",
            "/local-directory"
        ]
        },
        "Browser": {
            "type": "stdio",
            "command": "node",
            "args": ["/Users/local-path/browser-mcp/node_modules/@browsermcp/mcp/dist/index.js"]
        },
        "DuckDuckGo": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "mcp/duckduckgo"
            ]
        },
        "Markdown": {
            "type": "stdio",
            "command": "docker",
            "args": [
                "run", "-i", "--rm", "-v",
                "/Users/local-path/workspace:/local-directory",
                "mcp/markitdown"
            ]
        },
        "Thinking": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "mcp/sequentialthinking"
            ]
        },
        "Memory": {
        "command": "docker",
        "args": [
            "run",
            "-i",
            "--rm",
            "-v",
            "/Users/local-path/workspace:/local-directory",
            "mcp/memory"
            ]
        },
        "Youtube": {
            "type": "stdio",
            "command": "docker",
            "args": ["run", "-i", "--rm", "mcp/youtube-transcript"]
        },
        "Web Fetch": {
            "type": "stdio",
            "command": "docker",
            "args": ["run", "-i", "--rm", "mcp/fetch"]
        }
    }
}
